{
  "name": "@widgets/render",
  "version": "0.1.0",
  "description": "Shared canvas rendering kit for the Widgets collection: geometry, hit-testing, glyphs and drawing primitives.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/fake-context.d.ts",
      "import": "./dist/testing/fake-context.js",
      "default": "./dist/testing/fake-context.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@widgets/core": "0.1.0"
  }
}
