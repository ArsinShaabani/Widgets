{
  "name": "@widgets/container-grid",
  "version": "0.1.0",
  "description": "Cross-platform container fleet grid: responsive pod/service health cards with live CPU, memory, restarts and capacity rollups.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/index.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/container-grid.global.js",
  "jsdelivr": "./dist/container-grid.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js",
      "default": "./dist/auto.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@widgets/core": "0.1.0",
    "@widgets/render": "0.1.0"
  }
}
